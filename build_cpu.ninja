# strata-cpu build: the CPU expert path (src\cpu_moe.cpp) and its test ABI, as build\strata_cpu_test.dll.
# Run through build_cpu.bat, which sets vcvars64 and the CUDA INCLUDE/LIB/PATH entries (no paths with spaces
# appear here on purpose). This file has its own builddir so its .ninja_log does not mix with build.ninja's.
#
# Compiled with /arch:AVX2 (the Rust build uses target-cpu=native, which enables AVX2 on an AVX2 CPU; the
# AVX2 kernels in cpu_moe.cpp are compiled when __AVX2__ is defined).

builddir = build/cpu

cflags = /nologo /O2 /std:c++20 /EHsc /W4 /wd4100 /MD /arch:AVX2 /Z7 /D_CRT_SECURE_NO_WARNINGS /DNOMINMAX

rule cc
  command = cl /showIncludes $cflags /c $in /Fo$out
  description = CC $in
  deps = msvc

rule link_dll
  command = cl /nologo /LD $in /Fe:$out /link /IMPLIB:build/strata_cpu_test.lib advapi32.lib
  description = DLL $out

build build/cpu/gguf.obj: cc src/gguf.cpp
build build/cpu/quant.obj: cc src/quant.cpp
build build/cpu/config.obj: cc src/config.cpp
build build/cpu/weights.obj: cc src/weights.cpp
build build/cpu/memory.obj: cc src/memory.cpp
build build/cpu/cpu_moe.obj: cc src/cpu_moe.cpp | src/cpu_moe.h src/tables_host.h
build build/cpu/cpu_worker.obj: cc src/cpu_worker.cpp | src/cpu_worker.h src/cpu_moe.h
build build/cpu/backend.obj: cc src/backend.cpp | src/backend.h
build build/cpu/ds_ops.obj: cc src/ds_ops.cpp | src/ds_ops.h
build build/cpu/ds_mat.obj: cc src/ds_mat.cpp | src/ds_mat.h src/backend.h src/cpu_moe.h
build build/cpu/glm.obj: cc src/glm.cpp | src/glm.h src/ds_mat.h src/ds_ops.h
build build/cpu/glm_forward.obj: cc src/glm_forward.cpp | src/glm.h src/ds_mat.h src/ds_ops.h
build build/cpu/cpu_test_api.obj: cc src/cpu_test_api.cpp | src/cpu_moe.h src/cpu_worker.h src/glm.h src/ds_mat.h src/ds_ops.h

build build/strata_cpu_test.dll: link_dll build/cpu/gguf.obj build/cpu/quant.obj build/cpu/config.obj build/cpu/weights.obj build/cpu/memory.obj build/cpu/cpu_moe.obj build/cpu/cpu_worker.obj build/cpu/backend.obj build/cpu/ds_ops.obj build/cpu/ds_mat.obj build/cpu/glm.obj build/cpu/glm_forward.obj build/cpu/cpu_test_api.obj

default build/strata_cpu_test.dll
